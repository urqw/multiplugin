:main
pln Hello, World!
if not red then btn red_on, Red text
if red then btn red_off, Standart color text
if not italic then btn italic_on, Italic font
if italic then btn italic_off, Roman font
btn eval, Execute JavaScript
end

:red_on
res = CSSAdd("css/red.css")
pln The CSSAdd() function returned #res$
red = res
goto main

:red_off
res = CSSDel()
pln The CSSDel() function returned #res$
red = not res
goto main

:italic_on
res = CSSAdd("css/italic.css", "italic")
pln The CSSAdd() function returned #res$
italic = res
goto main

:italic_off
res = CSSDel("italic")
pln The CSSDel() function returned #res$
italic = not res
goto main

:eval
res = JSEval("js/input.js")
pln The JSEval() function returned #res$
goto main
